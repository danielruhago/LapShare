# Supabase → Project Settings → Database → Connection string
# Use the URI (session pooler on port 5432, or transaction pooler on 6543).
# Append ?sslmode=require if it is not already in the URI.
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=

# Public origin of this app (local or production)
BETTER_AUTH_URL=http://localhost:3000
